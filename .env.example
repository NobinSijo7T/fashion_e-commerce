# Copy to .env.local and fill in from Supabase: Project Settings → API (or Connect dialog).
# For production / custom domain hosting, set the same variables in your host’s env UI (Vercel, Netlify, etc.).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# New publishable key (recommended on hosted Supabase):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Legacy anon JWT (optional — use if you have not migrated to publishable keys yet):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Database: run supabase/migrations/20260411120000_fashion_commerce_schema.sql once in the Supabase SQL Editor (Dashboard → SQL).
